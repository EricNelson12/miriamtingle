---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SideNav from "../components/SideNav.astro";
import { SITE_TITLE, SITE_DESCRIPTION, photoUrl, photoSrcSet } from "../consts";
import imageDimensions from "../image-dimensions.json";

// .small-image is up to 50% of the .container (90vw, capped at 1100px) on
// desktop and 85% of it on phones; .big-image is up to 100% of the same
// container. Both are also capped by max-height in src/styles/global.css —
// keep these values in sync with the rules there.
const SMALL_IMAGE_SIZES = "(min-width: 1223px) 550px, (min-width: 760px) 45vw, 77vw";
const BIG_IMAGE_SIZES = "(min-width: 1223px) 1100px, 90vw";

const images2025 = ["backyardpink", "mallamute", "shannonfalls", "sunlightonthemountains", "torontofall", "wilson"];
const images2024 = ["04sunflowerfire", "01smokeysun_small", "05redroad", "07lakewind"];

// Intrinsic dimensions of the largest generated variant of each photo, used
// so the browser can reserve layout space (the aspect ratio) before the
// image loads — actual rendered size is set by CSS. Generated by
// `npm run photos` (or `npm run photos:dimensions`); don't edit by hand.
const IMAGE_DIMENSIONS: Record<string, { width: number; height: number }> = imageDimensions;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<div class="container side-nav-anchor">
				<SideNav />
			</div>

			<section id="2025">
			{images2025.map((name, index) => (
				<div class="container">
					<div class="content-wrapper">
						<img
							class="small-image"
							src={photoUrl(name)}
							srcset={photoSrcSet(name)}
							sizes={SMALL_IMAGE_SIZES}
							width={IMAGE_DIMENSIONS[name].width}
							height={IMAGE_DIMENSIONS[name].height}
							alt=""
							loading={index === 0 ? "eager" : "lazy"}
							fetchpriority={index === 0 ? "high" : undefined}
							decoding="async"
						/>
					</div>
				</div>
			))}
			</section>

			<section id="2024">
			{images2024.map((name) => (
				<div class="container">
					<div class="content-wrapper">
						<img
							class="big-image"
							src={photoUrl(name)}
							srcset={photoSrcSet(name)}
							sizes={BIG_IMAGE_SIZES}
							width={IMAGE_DIMENSIONS[name].width}
							height={IMAGE_DIMENSIONS[name].height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			))}

			<div class="container">
				<div class="content-wrapper">
					<img
						class="small-image"
						src={photoUrl("pencildrawinggreenflowers")}
						srcset={photoSrcSet("pencildrawinggreenflowers")}
						sizes={SMALL_IMAGE_SIZES}
						width={IMAGE_DIMENSIONS.pencildrawinggreenflowers.width}
						height={IMAGE_DIMENSIONS.pencildrawinggreenflowers.height}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
