---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION, photoUrl, photoSrcSet } from "../consts";

// .small-image is 50% of the .container (90vw, capped at 1100px).
// .big-image is 100% of the same container. Keep these in sync with the
// width/max-width rules in src/styles/global.css.
const SMALL_IMAGE_SIZES = "(min-width: 1223px) 550px, 45vw";
const BIG_IMAGE_SIZES = "(min-width: 1223px) 1100px, 90vw";

const images2025 = ["backyardpink", "mallamute", "shannonfalls", "sunlightonthemountains", "torontofall", "wilson"];
const images2024 = ["04sunflowerfire", "01smokeysun_small", "05redroad", "07lakewind"];

// Intrinsic dimensions of the largest (1600w) generated variant, used so the
// browser can reserve layout space before the image loads. These are only
// used to derive the aspect ratio — actual rendered size is set by CSS.
const IMAGE_DIMENSIONS: Record<string, { width: number; height: number }> = {
	backyardpink: { width: 1142, height: 1696 },
	mallamute: { width: 1600, height: 1124 },
	shannonfalls: { width: 1600, height: 1113 },
	sunlightonthemountains: { width: 1600, height: 1134 },
	torontofall: { width: 1600, height: 1134 },
	wilson: { width: 1600, height: 1114 },
	"04sunflowerfire": { width: 1600, height: 2133 },
	"01smokeysun_small": { width: 1600, height: 2133 },
	"05redroad": { width: 1600, height: 2133 },
	"07lakewind": { width: 1600, height: 2133 },
	pencildrawinggreenflowers: { width: 1016, height: 1618 },
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<div class="site-nav">
				<div class="container">
					<p class="text">2025</p>
				</div>
			</div>

			{images2025.map((name, index) => (
				<div class="container">
					<div class="content-wrapper">
						<img
							class="small-image"
							src={photoUrl(name)}
							srcset={photoSrcSet(name)}
							sizes={SMALL_IMAGE_SIZES}
							width={IMAGE_DIMENSIONS[name].width}
							height={IMAGE_DIMENSIONS[name].height}
							alt=""
							loading={index === 0 ? "eager" : "lazy"}
							fetchpriority={index === 0 ? "high" : undefined}
							decoding="async"
						/>
					</div>
				</div>
			))}

			<div class="site-nav">
				<div class="container">
					<p class="text">2024</p>
				</div>
			</div>

			{images2024.map((name) => (
				<div class="container">
					<div class="content-wrapper">
						<img
							class="big-image"
							src={photoUrl(name)}
							srcset={photoSrcSet(name)}
							sizes={BIG_IMAGE_SIZES}
							width={IMAGE_DIMENSIONS[name].width}
							height={IMAGE_DIMENSIONS[name].height}
							alt=""
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			))}

			<div class="container">
				<div class="content-wrapper">
					<img
						class="small-image"
						src={photoUrl("pencildrawinggreenflowers")}
						srcset={photoSrcSet("pencildrawinggreenflowers")}
						sizes={SMALL_IMAGE_SIZES}
						width={IMAGE_DIMENSIONS.pencildrawinggreenflowers.width}
						height={IMAGE_DIMENSIONS.pencildrawinggreenflowers.height}
						alt=""
						loading="lazy"
						decoding="async"
					/>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>
